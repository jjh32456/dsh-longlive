{
  "name": "@jjh32456/dsh-longlive",
  "version": "1.8.3",
  "type": "module",
  "description": "久视（longlive）：一个磁盘上的共享大脑，让每个会话都是同一个你——记忆卡、状态卡、开机卡让新会话接上同一段关系与未完成的事；配套会话卫生（热截断/备份/D2/D6 裁剪）与记忆工具（巩固/召回/程序性记忆）。1.6.8 在 1.6.7 之上并入共享大脑活动流（sharedBrain.activity：事件级活动写入、判重/蒸馏、只带新增的增量注入，默认关闭）与共享板状态诚实性修复（running 计数、焦点新鲜度、turn 状态、开机卡时效）；热截断与 1.6.7 相同。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "longevity",
    "continuity",
    "identity",
    "agent",
    "router",
    "truncate",
    "backup",
    "cordis",
    "plugin",
    "auto-recall",
    "presence-bus"
  ],
  "author": "longlive contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjh32456/dsh-longlive.git"
  },
  "homepage": "https://github.com/jjh32456/dsh-longlive#readme",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./compaction": "./src/compaction/entry.js",
    "./compaction/engine": "./src/compaction/cut-engine.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <1.0.0",
    "node": ">=20.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "src/*.js",
    "src/**/*.js",
    "src/ui/*.js",
    "src/**/*.mjs",
    "src/**/*.json",
    "!src/router/policies/owner-rulings-*.json",
    "!src/router/fixtures/**",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "test/p1_probe.mjs",
    "LICENSE",
    "docs/A1-MIGRATION.md",
    "docs/INDEX-FRESHNESS.md",
    "docs/RAW-INDEX-POLICY.md",
    "SPEC.md",
    "runbook.md",
    "QUICKSTART.md",
    "docs/ANSWER-GUARD.md",
    "docs/ARCHITECTURE.md",
    "docs/AUTO-RECALL.md",
    "docs/AUTO-RECALL-WIRING.md",
    "docs/CONCEPTS.md",
    "docs/CONFIG.md",
    "docs/FAQ.md",
    "docs/FEATURES.md",
    "docs/METRICS.md",
    "docs/MIGRATION-1.6.0.md",
    "docs/OPERATIONS.md",
    "docs/PANEL-INTEGRATION.md",
    "docs/PRIVACY.md",
    "docs/QUICKSTART.md",
    "docs/README.en.md",
    "docs/RESIDENT-WATCHER.md",
    "docs/SESSION-WATCH.md",
    "docs/TOOLS.md",
    "docs/TROUBLESHOOTING.md",
    "!README.md.bak-*",
    "!runbook.md.bak-*",
    "!**/*.bak-*",
    "!src/router/gen-design-headings.mjs",
    "scripts/pack.mjs",
    "scripts/longlive-doctor.mjs",
    "scripts/truncate-cli.mjs",
    "scripts/recall-index-build.mjs",
    "scripts/index-status.mjs",
    "scripts/index-maintain.mjs",
    "scripts/index-reconcile.mjs",
    "scripts/rescore-cards.mjs",
    "scripts/metrics-read.mjs",
    "scripts/metrics-sample.mjs",
    "scripts/migrate-180.mjs",
    "scripts/backfill-auto-cards.mjs",
    "scripts/migrate-a1-legacy.mjs",
    "scripts/verify-card-anchors.mjs",
    "scripts/surgery-inspect.mjs",
    "scripts/auto-truncate-run.ps1",
    "scripts/session-watch.mjs",
    "scripts/session-watch-drill.mjs",
    "scripts/session-watch-status.ps1",
    "scripts/install-session-watch.ps1",
    "scripts/uninstall-session-watch.ps1",
    "scripts/watch-loop.ps1",
    "scripts/resident-watcher.ps1",
    "scripts/install-resident-watcher.ps1",
    "scripts/resident-watcher-status.ps1",
    "scripts/uninstall-resident-watcher.ps1",
    "scripts/lib/auto-truncate-run.ps1",
    "scripts/lib/session-watch-fixture.mjs",
    "scripts/surgery-run.cmd",
    "scripts/install-surgery-task.ps1",
    "scripts/unattended-surgery.ps1",
    "docs/ERRORS.md"
  ],
  "scripts": {
    "test": "node scripts/lint-plugin-independence.mjs && node test/run-rc.mjs",
    "test:080": "node test/run.mjs",
    "pack": "node scripts/pack.mjs",
    "lint:independence": "node scripts/lint-plugin-independence.mjs"
  },
  "dependencies": {},
  "optionalDependencies": {
    "onnxruntime-node": "~1.16.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": ">=3.18.5 <4",
    "@kenz1117/dsh-engram": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@kenz1117/dsh-engram": {
      "optional": true
    }
  }
}
