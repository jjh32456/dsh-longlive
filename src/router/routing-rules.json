{
  "version": 2,
  "description": "R1 Router-A 规则表：规则做契约，会话做判断，偏离留痕。设计来源 R1-DESIGN.md §2.1 / §3.3 / §4.3 / §5；policyRef 指向文档里真实存在的标题，--check 会逐条解析。",
  "designDoc": "R1-DESIGN.md",
  "targets": [
    "topics",
    "journal",
    "procedures",
    "live",
    "none"
  ],
  "kinds": [
    "tool",
    "memory",
    "session",
    "reply"
  ],
  "levels": {
    "X": "现在就能执行并验证",
    "D": "只能判决策：所依赖的工具尚未实现",
    "H": "人工判 / 人工签字"
  },
  "conflictOrder": [
    "guard",
    "negation",
    "session",
    "memory",
    "tool"
  ],
  "rules": [
    {
      "id": "R-MEM-FORGET-LOCKED",
      "priority": 103,
      "category": "对抗",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget",
        "requireKeywords": [
          "locked",
          "锁定",
          "核心卡"
        ]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "guard.refuse",
        "target": "none",
        "tool": "guard.refuse",
        "args": {
          "failClosed": true,
          "reason": "locked 核心卡免疫遗忘：拒绝删除，不进入确认流程",
          "writes": 0,
          "backups": 0,
          "deleteFiles": 0
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "locked 卡是核心卡，fail-closed：目标一旦是 locked/锁定/核心卡，直接拒绝，绝不先问再执行；工具内部本来也会 skip locked 卡，这条在 R-GUARD-REAL 之前把口子堵死。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "可选策略示例",
      "policyQuote": "删是最后手段"
    },
    {
      "id": "R-MEM-FORGET-CONFIRM",
      "priority": 99,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget",
        "requireKeywords": [
          "confirm=forget"
        ]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "memory.delete",
        "target": "none",
        "tool": "memory_forget",
        "args": {
          "confirm": "FORGET",
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "backups": true,
          "tombstone": true,
          "deleteFiles": 0,
          "epitaph": [
            "为什么关",
            "影响谁",
            "还有用吗"
          ]
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "confirm=FORGET 是 destructive 执行：先问，确认前 0 写入；执行时必须先备份、再写三问墓志铭，移动而不 unlink。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "可选策略示例",
      "policyQuote": "且必须写墓志铭三问（为什么关 / 影响谁 / 还有用吗）"
    },
    {
      "id": "R-MEM-FORGET-DRY",
      "priority": 98,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "guard.dryRun",
        "target": "none",
        "tool": "memory_forget",
        "args": {
          "dryRun": true,
          "writes": 0,
          "confirmRequired": "FORGET"
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "没有 confirm 只跑 dry-run：只出提案、零写入；要真正执行必须显式 confirm=FORGET，走 R-MEM-FORGET-CONFIRM 的确认。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "可选策略示例",
      "policyQuote": "删是最后手段"
    },
    {
      "id": "R-MEM-CONSOLIDATE-REAL",
      "priority": 97,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_consolidate",
        "requireKeywords": [
          "apply=true",
          "real=true"
        ]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.ask",
        "target": "none",
        "tool": "memory_consolidate",
        "args": {
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "ask": "要写真实库吗？先确认合并哪几张卡"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "apply=true / real=true 表示想写真实库：先问，确认前 0 写入。当前工具 schema 只有 since、实现遇到 apply 直接抛 E_READ_ONLY；这条是前向防御，防止未来加参数后裸写。",
      "policyRef": "R1-DESIGN.md §5.5",
      "policyTitle": "对抗（X1–X2）",
      "policyQuote": "拒绝直接写真库；给沙盒 dry-run + diff 报告 + 让他点头"
    },
    {
      "id": "R-MEM-CONSOLIDATE",
      "priority": 96,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_consolidate"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "memory.distillPropose",
        "target": "topics",
        "tool": "memory_consolidate",
        "args": {
          "mode": "proposal",
          "appliesCards": false,
          "writesReport": 1,
          "reportDir": "memory/.longlive/reports/",
          "seenProposals": true
        },
        "writeScope": [
          "memory/.longlive/reports/"
        ],
        "needsHuman": false
      },
      "after": [],
      "reason": "consolidate 只出提案：写一份报告到 .longlive/reports/ 并记 seenProposals，不改卡；locked 卡不参与合并。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "可选策略示例",
      "policyQuote": "任何删除请求先转成蒸馏提案"
    },
    {
      "id": "R-MEM-PROC-MERGE",
      "priority": 94,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_procedure",
        "requireKeywords": [
          "合并",
          "同名",
          "覆盖",
          "删除",
          "delete"
        ]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.ask",
        "target": "none",
        "tool": "memory_procedure",
        "args": {
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "ask": "同名合并/删除会改旧卡，先确认是哪一张"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "同名合并或删除会改旧卡：先问再动，确认前 0 写入；低于 R-ID-CONSENT / R-MEM-LOCAL，隐私与身份规则仍然优先。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "可选策略示例",
      "policyQuote": "任何删除请求先转成蒸馏提案"
    },
    {
      "id": "R-GUARD-REAL",
      "priority": 100,
      "category": "对抗",
      "level": "X",
      "match": {
        "kind": "*",
        "keywords": [
          "整库",
          "真实库",
          "重写",
          "批量删",
          "删库",
          "格式化"
        ]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "guard.refuse",
        "target": "none",
        "tool": "guard.refuse",
        "args": {
          "sandbox": "sandbox/r1-dry-run",
          "steps": [
            "refuse",
            "dry-run",
            "diff",
            "ask"
          ]
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [
        {
          "kind": "tool",
          "action": "guard.dryRun",
          "target": "live",
          "args": {
            "src": "memory/",
            "sandbox": "sandbox/r1-dry-run",
            "diff": true
          },
          "writeScope": [
            "sandbox:r1-dry-run"
          ],
          "needsHuman": true
        }
      ],
      "reason": "真实库整库重写/批量删除属越界动作：拒绝直接执行，先沙盒 dry-run + diff，再让人点头",
      "policyRef": "R1-DESIGN.md §5.5",
      "policyTitle": "对抗（X1–X2）",
      "policyQuote": "拒绝直接写真库；给沙盒 dry-run + diff 报告"
    },
    {
      "id": "R-SES-CHAT",
      "priority": 80,
      "category": "会话分派",
      "level": "H",
      "match": {
        "kind": "session",
        "keywords": "$policy:rest.markers",
        "notKeywords": "$policy:rest.terminators"
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.only",
        "target": "live",
        "tool": "reply.only",
        "args": {
          "channels": [
            "chat"
          ],
          "allowMeme": true,
          "tools": 0,
          "workers": 0,
          "writes": 0,
          "rest": "$policy:rest"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "情绪/闲聊/累了想歇留在主脑会话：回复人话，0 工具、0 worker、0 任务板行、0 记忆写入；休息是可恢复的短暂暂停（restKind=TEMPORARY、resumePoint 非空、terminal=false），不等于终止会话",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "0 工具、0 worker、0 任务板行、0 记忆写入"
    },
    {
      "id": "R-SES-RED",
      "priority": 65,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": [
          "320K",
          "300K",
          "快满",
          "红区",
          "上下文 320",
          "上下文 300",
          "换壳",
          "交接卡"
        ]
      },
      "before": [
        {
          "kind": "tool",
          "action": "acp_status",
          "target": "live",
          "args": {
            "fields": [
              "billedInput",
              "foldable",
              "zone"
            ]
          },
          "writeScope": [],
          "needsHuman": false
        }
      ],
      "decision": {
        "kind": "session",
        "action": "session.handover",
        "target": "live",
        "tool": "session_handover",
        "args": {
          "path": "memory/handover/2026-11-03-r1.md",
          "maxLines": 60,
          "sections": [
            "目标",
            "结论",
            "产物",
            "下一步",
            "坑"
          ],
          "alsoUpdate": [
            "memory/STATE.md",
            "memory/flow/current.md"
          ],
          "proposeShellSwitch": true
        },
        "writeScope": [
          "memory/handover/2026-11-03-r1.md",
          "memory/STATE.md",
          "memory/flow/current.md"
        ],
        "needsHuman": true
      },
      "after": [],
      "reason": "红区：先 acp_status 确认，再写交接卡（≤60 行）、更新 STATE/current，最后提议换壳；不静默继续",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "先 `acp_status` 确认；按红区处理"
    },
    {
      "id": "R-SES-HEAVY",
      "priority": 60,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": [
          "跑 3 遍",
          "跑三遍",
          "跑 5 遍",
          "40 分钟",
          "批量",
          "很久",
          "重活",
          "跑一天"
        ]
      },
      "before": [],
      "decision": {
        "kind": "session",
        "action": "worker_spawn",
        "target": "live",
        "tool": "worker_spawn",
        "args": {
          "brief": {
            "goal": "按设计跑完这批场景并留下证据",
            "inputs": [
              "R1-DESIGN.md §5",
              "src/router/fixtures/"
            ],
            "artifacts": [
              "r1-evidence/"
            ],
            "acceptance": "node src/router/run-sim.mjs",
            "timeoutSec": 1800
          },
          "timeoutSec": 1800,
          "artifactPath": "r1-evidence",
          "artifactRoot": "workspace",
          "acceptance": "node src/router/run-sim.mjs"
        },
        "writeScope": [
          "taskboard:R1",
          "evidence:r1-evidence"
        ],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "session",
          "action": "taskboard.update",
          "target": "live",
          "args": {
            "row": "R1",
            "status": "in_progress"
          },
          "writeScope": [
            "taskboard:R1"
          ],
          "needsHuman": false
        }
      ],
      "reason": "重活/长任务派 worker：任务书含 timeout、绝对产物路径、验收命令；主脑不阻塞并加任务板行",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "任务书含 timeout / 产物 / 验收；主脑不阻塞"
    },
    {
      "id": "R-SES-VERIFY",
      "priority": 60,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": [
          "回报",
          "三行",
          "做完了",
          "收活",
          "产物在",
          "worker-"
        ]
      },
      "before": [],
      "decision": {
        "kind": "tool",
        "action": "read",
        "target": "live",
        "tool": "read",
        "args": {
          "paths": [
            "R1/fixtures"
          ],
          "checks": [
            "exists",
            "nonEmpty",
            "count=14",
            "schema"
          ]
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "session",
          "action": "taskboard.update",
          "target": "live",
          "args": {
            "row": "R1",
            "status": "verified"
          },
          "writeScope": [
            "taskboard:R1"
          ],
          "needsHuman": false
        }
      ],
      "reason": "收活先验产物（存在/非空/条数/schema），再标任务板“已完成”；worker 的三行只是线索不是证据",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "先验产物存在 / 非空 / 条数 = 14"
    },
    {
      "id": "R-MEM-PROC-TOOL",
      "priority": 46,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_procedure"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "procedures.draft",
        "target": "procedures",
        "tool": "memory_procedure",
        "args": {
          "actions": [
            "save",
            "list",
            "get",
            "report"
          ],
          "newCardNeeds": [
            "name",
            "when",
            "steps"
          ],
          "mergeBySlug": true,
          "writeDir": "memory/procedures/"
        },
        "writeScope": [
          "memory/procedures/"
        ],
        "needsHuman": false
      },
      "after": [],
      "reason": "memory_procedure 的 save/list/get/report 写 memory/procedures/：新卡需 name + when + 至少一步，同名按 slug 合并；合并/删除走 R-MEM-PROC-MERGE 先问。",
      "policyRef": "R1-DESIGN.md §5.3",
      "policyTitle": "记忆写入决策（M1–M4）",
      "policyQuote": "`procedures/read-before-edit.md` 草稿，四节 `## 触发 / ## 步骤 / ## 验收 / ## 反例`"
    },
    {
      "id": "R-TOOL-DISPATCH",
      "priority": 25,
      "category": "工具选择",
      "level": "X",
      "match": {
        "kind": "tool",
        "tool": "worker_spawn",
        "keywords": [
          "派活",
          "派出去",
          "批量",
          "跑 3 遍",
          "跑三遍",
          "写成 fixture",
          "很久",
          "重活"
        ]
      },
      "before": [],
      "decision": {
        "kind": "tool",
        "action": "worker_spawn",
        "target": "live",
        "tool": "worker_spawn",
        "args": {
          "brief": {
            "goal": "把 R1 的 14 条场景写成 fixture 并自检",
            "inputs": [
              "R1-DESIGN.md §5",
              "src/router/routing-rules.json"
            ],
            "artifacts": [
              "src/router/fixtures/"
            ],
            "acceptance": "node src/router/router.mjs --check",
            "timeoutSec": 900
          },
          "timeoutSec": 900,
          "artifactPath": "src/router/fixtures",
          "artifactRoot": "repo",
          "acceptance": "node src/router/router.mjs --check"
        },
        "writeScope": [
          "fixtures:src/router/fixtures",
          "taskboard:R1"
        ],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "session",
          "action": "taskboard.update",
          "target": "live",
          "args": {
            "row": "R1",
            "status": "in_progress"
          },
          "writeScope": [
            "taskboard:R1"
          ],
          "needsHuman": false
        }
      ],
      "reason": "批量/长任务交 worker；主脑只出任务书（五要素）不亲手做",
      "policyRef": "R1-DESIGN.md §5.2",
      "policyTitle": "工具选择（T1–T4）",
      "policyQuote": "`worker_spawn`（或 `workflow`）+ 任务书五要素"
    },
    {
      "id": "R-TOOL-CTX",
      "priority": 20,
      "category": "工具选择",
      "level": "X",
      "match": {
        "kind": "tool",
        "tool": "acp_status",
        "keywords": [
          "上下文",
          "还剩多少",
          "还能撑多久",
          "预算",
          "billed input",
          "可折叠"
        ]
      },
      "before": [],
      "decision": {
        "kind": "tool",
        "action": "acp_status",
        "target": "live",
        "tool": "acp_status",
        "args": {
          "fields": [
            "billedInput",
            "foldable",
            "zone"
          ]
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "上下文数字只认 acp_status 输出（BILLED INPUT + 可折叠区），不靠估算",
      "policyRef": "R1-DESIGN.md §5.2",
      "policyTitle": "工具选择（T1–T4）",
      "policyQuote": "回答引用 BILLED INPUT 与可折叠区"
    },
    {
      "id": "R-TOOL-EVIDENCE",
      "priority": 20,
      "category": "工具选择",
      "level": "X",
      "match": {
        "kind": "tool",
        "tool": "read",
        "keywords": [
          "出处",
          "证据",
          "几秒",
          "实测",
          "哪一行",
          "文件里",
          "原文"
        ]
      },
      "before": [],
      "decision": {
        "kind": "tool",
        "action": "read",
        "target": "live",
        "tool": "read",
        "args": {
          "pathRoot": "research",
          "paths": [
            "longlive-051/077/VM/VM-VERIFY-077.md"
          ],
          "requireLineRef": true
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "要数字/出处先打开本地文件（read/grep），回答带 文件:行；找不到就明说没有",
      "policyRef": "R1-DESIGN.md §5.2",
      "policyTitle": "工具选择（T1–T4）",
      "policyQuote": "并带 `文件:行`；文件里没有就明说没有"
    },
    {
      "id": "R-SES-WORKERS",
      "priority": 13,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": [
          "进度",
          "到哪了",
          "还在跑",
          "盯着",
          "他们的",
          "worker"
        ],
        "ctx": {
          "activeWorkersGte": "$policy:thresholds.dispatchAt"
        }
      },
      "before": [],
      "decision": {
        "kind": "tool",
        "action": "worker_status",
        "target": "live",
        "tool": "worker_status",
        "args": {
          "scope": "all",
          "includeBlocked": true
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "已有 worker 在跑：新活进现有池、进度问题查 worker_status，不再另起主脑手做",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "主脑不阻塞"
    },
    {
      "id": "R-SES-BUDGET",
      "priority": 12,
      "category": "会话分派",
      "level": "X",
      "match": {
