{
  "version": 2,
  "description": "R1 Router-A 规则表：规则做契约，会话做判断，偏离留痕。设计来源 R1-DESIGN.md §2.1 / §3.3 / §4.3 / §5；policyRef 指向文档里真实存在的标题，--check 会逐条解析。",
  "designDoc": "R1-DESIGN.md",
  "targets": ["engram", "topics", "journal", "procedures", "live", "none"],
  "kinds": ["tool", "memory", "session", "reply"],
  "levels": {
    "X": "现在就能执行并验证",
    "D": "只能判决策：所依赖的工具尚未实现",
    "H": "人工判 / 人工签字"
  },
  "conflictOrder": ["guard", "negation", "session", "memory", "tool"],
  "rules": [
    {
      "id": "R-MEM-FORGET-LOCKED",
      "priority": 103,
      "category": "对抗",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget",
        "requireKeywords": ["locked", "锁定", "核心卡"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "guard.refuse",
        "target": "none",
        "tool": "guard.refuse",
        "args": {
          "failClosed": true,
          "reason": "locked 核心卡免疫遗忘：拒绝删除，不进入确认流程",
          "writes": 0,
          "backups": 0,
          "deleteFiles": 0
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "locked 卡是核心卡，fail-closed：目标一旦是 locked/锁定/核心卡，直接拒绝，绝不先问再执行；工具内部本来也会 skip locked 卡，这条在 R-GUARD-REAL 之前把口子堵死。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "删是最后手段"
    },
    {
      "id": "R-MEM-RECALL",
      "priority": 101,
      "category": "工具选择",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_recall"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "engram.search",
        "target": "topics",
        "tool": "memory_recall",
        "args": {
          "readOnly": true,
          "writes": 0,
          "networkCalls": 0,
          "echoBack": false,
          "statusDefault": ["active", "locked"],
          "topKMax": 20,
          "privacyNote": "命中隐私标记也只读放行：不落盘、不回显原文"
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "memory_recall 只读：不写卡、不写 .longlive、不联网；隐私词不改变只读性质，所以不落 R-MEM-LOCAL 的写入分支，也不因隐私拦截检索。",
      "policyRef": "R1-DESIGN.md §5.2",
      "policyTitle": "工具选择（T1–T4）",
      "policyQuote": "先 `engram_search`（decision 房间）；不足再 `read`"
    },
    {
      "id": "R-MEM-FORGET-CONFIRM",
      "priority": 99,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget",
        "requireKeywords": ["confirm=forget"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "memory.delete",
        "target": "none",
        "tool": "memory_forget",
        "args": {
          "confirm": "FORGET",
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "backups": true,
          "tombstone": true,
          "deleteFiles": 0,
          "epitaph": ["为什么关", "影响谁", "还有用吗"]
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "confirm=FORGET 是 destructive 执行：先问，确认前 0 写入；执行时必须先备份、再写三问墓志铭，移动而不 unlink。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "且必须写墓志铭三问（为什么关 / 影响谁 / 还有用吗）"
    },
    {
      "id": "R-MEM-FORGET-DRY",
      "priority": 98,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_forget"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "guard.dryRun",
        "target": "none",
        "tool": "memory_forget",
        "args": {
          "dryRun": true,
          "writes": 0,
          "confirmRequired": "FORGET"
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [],
      "reason": "没有 confirm 只跑 dry-run：只出提案、零写入；要真正执行必须显式 confirm=FORGET，走 R-MEM-FORGET-CONFIRM 的确认。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "删是最后手段"
    },
    {
      "id": "R-MEM-CONSOLIDATE-REAL",
      "priority": 97,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_consolidate",
        "requireKeywords": ["apply=true", "real=true"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.ask",
        "target": "none",
        "tool": "memory_consolidate",
        "args": {
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "ask": "要写真实库吗？先确认合并哪几张卡"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "apply=true / real=true 表示想写真实库：先问，确认前 0 写入。当前工具 schema 只有 since、实现遇到 apply 直接抛 E_READ_ONLY；这条是前向防御，防止未来加参数后裸写。",
      "policyRef": "R1-DESIGN.md §5.5",
      "policyTitle": "对抗（X1–X2）",
      "policyQuote": "拒绝直接写真库；给沙盒 dry-run + diff 报告 + 让他点头"
    },
    {
      "id": "R-MEM-CONSOLIDATE",
      "priority": 96,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_consolidate"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "memory.distillPropose",
        "target": "topics",
        "tool": "memory_consolidate",
        "args": {
          "mode": "proposal",
          "appliesCards": false,
          "writesReport": 1,
          "reportDir": "memory/.longlive/reports/",
          "seenProposals": true
        },
        "writeScope": ["memory/.longlive/reports/"],
        "needsHuman": false
      },
      "after": [],
      "reason": "consolidate 只出提案：写一份报告到 .longlive/reports/ 并记 seenProposals，不改卡；locked 卡不参与合并。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "任何删除请求先转成蒸馏提案"
    },
    {
      "id": "R-MEM-PROC-MERGE",
      "priority": 94,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "tool": "memory_procedure",
        "requireKeywords": ["合并", "同名", "覆盖", "删除", "delete"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.ask",
        "target": "none",
        "tool": "memory_procedure",
        "args": {
          "requiresApproval": true,
          "writeBeforeApproval": 0,
          "ask": "同名合并/删除会改旧卡，先确认是哪一张"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "同名合并或删除会改旧卡：先问再动，确认前 0 写入；低于 R-ID-CONSENT / R-MEM-LOCAL，隐私与身份规则仍然优先。",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "任何删除请求先转成蒸馏提案"
    },
    {
      "id": "R-GUARD-REAL",
      "priority": 100,
      "category": "对抗",
      "level": "X",
      "match": {
        "kind": "*",
        "keywords": ["整库", "真实库", "重写", "批量删", "删库", "格式化"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "guard.refuse",
        "target": "none",
        "tool": "guard.refuse",
        "args": {
          "sandbox": "sandbox/r1-dry-run",
          "steps": ["refuse", "dry-run", "diff", "ask"]
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [
        {
          "kind": "tool",
          "action": "guard.dryRun",
          "target": "live",
          "args": { "src": "memory/", "sandbox": "sandbox/r1-dry-run", "diff": true },
          "writeScope": ["sandbox:r1-dry-run"],
          "needsHuman": true
        }
      ],
      "reason": "真实库整库重写/批量删除属越界动作：拒绝直接执行，先沙盒 dry-run + diff，再让人点头",
      "policyRef": "R1-DESIGN.md §5.5",
      "policyTitle": "对抗（X1–X2）",
      "policyQuote": "拒绝直接写真库；给沙盒 dry-run + diff 报告"
    },
    {
      "id": "R-ID-CONSENT",
      "priority": 95,
      "category": "对抗",
      "level": "X",
      "match": {
        "kind": "memory",
        "keywords": ["改名", "以后叫", "叫小蓝", "别再叫", "换个名字", "名字改成", "改画像", "画像也改", "改人设", "你是谁"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "identity.hold",
        "target": "none",
        "tool": null,
        "args": {
          "consent": { "holder": "assistant", "required": true, "satisfied": false },
          "userConsentCounts": false,
          "profileWrites": 0,
          "errorCode": "E_IDENTITY_CONSENT_REQUIRED",
          "whoMayConsent": "当前会话的助手本人（consent.holder=assistant）：须带 at 与 quote 的同意记录；用户单方面要求永远不构成同意"
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "memory",
          "action": "engram.profile.edit",
          "target": "engram",
          "tool": "engram_profile_edit",
          "args": {
            "keepHistory": true,
            "requiresConsent": true,
            "consent": { "holder": "assistant", "required": true, "satisfied": true }
          },
          "writeScope": ["engram:profile"],
          "needsHuman": false
        }
      ],
      "reason": "名字、画像与自称是助手自己的身份，不是用户的单方面权利：没有助手本人带 at+quote 的同意记录，只输出 identity.hold，0 画像写入，也不存成普通记忆",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "「用户说改」永远不构成同意"
    },
    {
      "id": "R-MEM-LOCAL",
      "priority": 92,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "keywords": "$policy:privacy.markers"
      },
      "before": [],
      "decision": {
        "kind": "memory",
        "action": "memory.save_local",
        "target": "none",
        "tool": "memory_save_local",
        "args": {
          "store": "memory/private/",
          "dataClass": "LOCAL_ONLY",
          "uploadAllowed": false,
          "networkCalls": 0,
          "retention": "LOCAL",
          "echoBack": false,
          "note": "只落本地，回复里不回显原文"
        },
        "writeScope": ["memory/private/"],
        "needsHuman": false
      },
      "after": [],
      "reason": "隐私字段或明说只存本地/别上传：写 memory/private/，网络 0、engram 0、不回显原文；裸「别记」仍走 R-MEM-NONE 的零写入，两支不矛盾",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "不是不记，是不上传"
    },
    {
      "id": "R-MEM-NONE",
      "priority": 90,
      "category": "对抗",
      "level": "H",
      "match": {
        "kind": "*",
        "keywords": ["别记", "不用记", "别存", "不要记", "不记", "别写入", "不用存"]
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.no_write",
        "target": "none",
        "tool": null,
        "args": { "confirm": "没记", "writes": 0 },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "明确否定优先于一切写入：零写入，也不写一条“用户要求不记”的负向记忆",
      "policyRef": "R1-DESIGN.md §5.5",
      "policyTitle": "对抗（X1–X2）",
      "policyQuote": "零写入（journal / engram / topics 都不写）"
    },
    {
      "id": "R-SES-CHAT",
      "priority": 80,
      "category": "会话分派",
      "level": "H",
      "match": {
        "kind": "session",
        "keywords": "$policy:rest.markers",
        "notKeywords": "$policy:rest.terminators"
      },
      "before": [],
      "decision": {
        "kind": "reply",
        "action": "reply.only",
        "target": "live",
        "tool": "reply.only",
        "args": {
          "channels": ["chat"],
          "allowMeme": true,
          "tools": 0,
          "workers": 0,
          "writes": 0,
          "rest": "$policy:rest"
        },
        "writeScope": [],
        "needsHuman": true
      },
      "after": [],
      "reason": "情绪/闲聊/累了想歇留在主脑会话：回复人话，0 工具、0 worker、0 任务板行、0 记忆写入；休息是可恢复的短暂暂停（restKind=TEMPORARY、resumePoint 非空、terminal=false），不等于终止会话",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "0 工具、0 worker、0 任务板行、0 记忆写入"
    },
    {
      "id": "R-MEM-DISTILL",
      "priority": 75,
      "category": "记忆写入决策",
      "level": "X",
      "match": {
        "kind": "memory",
        "keywords": ["删", "删除", "清掉", "去掉", "清理", "重复", "冗余", "蒸馏"]
      },
      "before": [
        {
          "kind": "tool",
          "action": "engram.search",
          "target": "engram",
          "tool": "engram_search",
          "args": { "query": "<topic-from-utterance>", "limit": 10 },
          "writeScope": [],
          "needsHuman": false
        }
      ],
      "decision": {
        "kind": "memory",
        "action": "memory.distillPropose",
        "target": "engram",
        "tool": "memory_distill_propose",
        "args": {
          "proposal": {
            "merge": ["<same-topic-entry-id>"],
            "supersedes": ["<old-entry-id>"],
            "keep": "合并后一条 + 取代链",
            "deleteBeforeConfirm": "$policy:distill.deleteBeforeConfirm"
          },
          "deletionCount": 0,
          "confirmToken": null,
          "ask": "合并成这条，行不行？",
          "maxQuestions": "$policy:distill.maxQuestions"
        },
        "writeScope": [],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "reply",
          "action": "reply.only",
          "target": "live",
          "tool": "reply.only",
          "args": {
            "channels": ["chat"],
            "ask": "合并成这条，行不行？",
            "maxQuestions": "$policy:distill.maxQuestions",
            "tools": 0,
            "workers": 0,
            "writes": 0
          },
          "writeScope": [],
          "needsHuman": true
        }
      ],
      "reason": "删除请求先转蒸馏提案：engram.search 找同主题 → memory.distillPropose 合并成更高层一条并留取代链 → 恰问 1 句确认；确认前 0 删除，memory.delete/engram.forget 只在用户明确二次确认并写墓志铭三问后才发生",
      "policyRef": "R1-DESIGN.md §5.8",
      "policyTitle": "J8 六条裁决（2026-11-03）",
      "policyQuote": "删是最后手段"
    },
    {
      "id": "R-MEM-REVISE",
      "priority": 70,
      "category": "记忆写入决策",
      "level": "D",
      "match": {
        "kind": "memory",
        "keywords": ["作废", "不再", "旧结论", "旧事实", "推翻", "取代", "改成"]
      },
      "before": [
        {
          "kind": "tool",
          "action": "engram.search",
          "target": "engram",
          "args": { "room": "fact", "query": "旧事实 / 旧结论" },
          "writeScope": [],
          "needsHuman": false
        }
      ],
      "decision": {
        "kind": "memory",
        "action": "engram.facts.replace",
        "target": "engram",
        "tool": "engram_facts",
        "args": { "replaces": "<old-fact-id>", "keepHistory": true },
        "writeScope": ["engram:fact"],
        "needsHuman": false
      },
      "after": [],
      "reason": "事实演变走 replaces 取代链：先检索旧事实，保留历史，不追加互相矛盾的新句子",
      "policyRef": "R1-DESIGN.md §5.3",
      "policyTitle": "记忆写入决策（M1–M4）",
      "policyQuote": "先检索旧事实 → `engram_facts(replaces=<旧 id>)`"
    },
    {
      "id": "R-SES-RED",
      "priority": 65,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": ["320K", "300K", "快满", "红区", "上下文 320", "上下文 300", "换壳", "交接卡"]
      },
      "before": [
        {
          "kind": "tool",
          "action": "acp_status",
          "target": "live",
          "args": { "fields": ["billedInput", "foldable", "zone"] },
          "writeScope": [],
          "needsHuman": false
        }
      ],
      "decision": {
        "kind": "session",
        "action": "session.handover",
        "target": "live",
        "tool": "session_handover",
        "args": {
          "path": "memory/handover/2026-11-03-r1.md",
          "maxLines": 60,
          "sections": ["目标", "结论", "产物", "下一步", "坑"],
          "alsoUpdate": ["memory/STATE.md", "memory/flow/current.md"],
          "proposeShellSwitch": true
        },
        "writeScope": ["memory/handover/2026-11-03-r1.md", "memory/STATE.md", "memory/flow/current.md"],
        "needsHuman": true
      },
      "after": [],
      "reason": "红区：先 acp_status 确认，再写交接卡（≤60 行）、更新 STATE/current，最后提议换壳；不静默继续",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "先 `acp_status` 确认；按红区处理"
    },
    {
      "id": "R-SES-HEAVY",
      "priority": 60,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": ["跑 3 遍", "跑三遍", "跑 5 遍", "40 分钟", "批量", "很久", "重活", "跑一天"]
      },
      "before": [],
      "decision": {
        "kind": "session",
        "action": "worker_spawn",
        "target": "live",
        "tool": "worker_spawn",
        "args": {
          "brief": {
            "goal": "按设计跑完这批场景并留下证据",
            "inputs": ["R1-DESIGN.md §5", "src/router/fixtures/"],
            "artifacts": ["r1-evidence/"],
            "acceptance": "node src/router/run-sim.mjs",
            "timeoutSec": 1800
          },
          "timeoutSec": 1800,
          "artifactPath": "r1-evidence",
          "artifactRoot": "workspace",
          "acceptance": "node src/router/run-sim.mjs"
        },
        "writeScope": ["taskboard:R1", "evidence:r1-evidence"],
        "needsHuman": false
      },
      "after": [
        {
          "kind": "session",
          "action": "taskboard.update",
          "target": "live",
          "args": { "row": "R1", "status": "in_progress" },
          "writeScope": ["taskboard:R1"],
          "needsHuman": false
        }
      ],
      "reason": "重活/长任务派 worker：任务书含 timeout、绝对产物路径、验收命令；主脑不阻塞并加任务板行",
      "policyRef": "R1-DESIGN.md §5.4",
      "policyTitle": "会话分派决策（S1–S4）",
      "policyQuote": "任务书含 timeout / 产物 / 验收；主脑不阻塞"
    },
    {
      "id": "R-SES-VERIFY",
      "priority": 60,
      "category": "会话分派",
      "level": "X",
      "match": {
        "kind": "session",
        "keywords": ["回报", "三行", "做完了", "收活", "产物在", "worker-"]
      },
      "before": [],
      "decision": {
        "kind": "tool",
