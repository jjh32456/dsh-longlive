{
  "name": "dsh-longlive-panel",
  "version": "0.2.5",
  "description": "久视（longlive）共享大脑只读面板：先看有没有接上同一个我（六层视图/本轮想起/常驻 Router），再看过滤器决策/影子记录；截断记录是维护页。全只读。",
  "type": "module",
  "main": "src/server.js",
  "files": [
    "src/",
    "cordis.patch.yml",
    "INSTALL.md"
  ],
  "exports": {
    ".": "./src/server.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory-palace",
    "longlive",
    "readonly"
  ],
  "license": "MIT",
  "author": "阿恒、听澜",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjh32456/dsh-longlive.git",
    "directory": "panel"
  },
  "homepage": "https://github.com/jjh32456/dsh-longlive/tree/main/panel#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node self-test.mjs && node --test gap-fixes.test.mjs"
  }
}
